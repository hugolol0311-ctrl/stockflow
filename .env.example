# Copie para .env. Obtenha estes valores no painel do seu próprio projeto Supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Chave publishable (sb_publishable_...) ou anon legada. NUNCA service_role/secret.
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
PORT=8080
# Em produção com HTTPS, defina true.
COOKIE_SECURE=false

# Apenas para o perfil vercel. Gere um segredo aleatório de 32 bytes (base64).
# Registre somente o SHA-256 no banco conforme docs/DEPLOY.md.
# SESSION_STORE_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
